# Leave DATABASE_URL as sqlite for instant zero-config local execution, or use Postgres:
DATABASE_URL=sqlite:///./claimguard.db
JWT_SECRET_KEY=change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AI_CONFIDENCE_THRESHOLD=0.75
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
CORS_ALLOWED_ORIGINS=http://localhost:3000
